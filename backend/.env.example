# Copy to .env and change the values. Never commit .env.

# Gateway (the only HTTP entry point)
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Microservices (TCP). Each service listens here; the gateway connects here.
AUTH_SERVICE_HOST=127.0.0.1
AUTH_SERVICE_PORT=3001
EMPLOYEE_SERVICE_HOST=127.0.0.1
EMPLOYEE_SERVICE_PORT=3002
ATTENDANCE_SERVICE_HOST=127.0.0.1
ATTENDANCE_SERVICE_PORT=3003

# MySQL (also used by docker-compose.yml)
DB_HOST=localhost
DB_PORT=3306
DB_USER=dexa_app
DB_PASSWORD=change_me_app_password
DB_ROOT_PASSWORD=change_me_root_password
DB_TIMEZONE=Asia/Jakarta

# One database per service
DB_AUTH_NAME=dexa_auth
DB_EMPLOYEE_NAME=dexa_employee
DB_ATTENDANCE_NAME=dexa_attendance

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Attendance photo upload
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=5
