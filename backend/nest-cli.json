{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/gateway",
  "sourceRoot": "apps/gateway/src",
  "compilerOptions": {
    "builder": "tsc",
    "deleteOutDir": true,
    "tsConfigPath": "apps/gateway/tsconfig.app.json"
  },
  "projects": {
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "sourceRoot": "apps/gateway/src",
      "entryFile": "apps/gateway/src/main",
      "compilerOptions": { "tsConfigPath": "apps/gateway/tsconfig.app.json" }
    },
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "sourceRoot": "apps/auth/src",
      "entryFile": "apps/auth/src/main",
      "compilerOptions": { "tsConfigPath": "apps/auth/tsconfig.app.json" }
    },
    "employee": {
      "type": "application",
      "root": "apps/employee",
      "sourceRoot": "apps/employee/src",
      "entryFile": "apps/employee/src/main",
      "compilerOptions": { "tsConfigPath": "apps/employee/tsconfig.app.json" }
    },
    "attendance": {
      "type": "application",
      "root": "apps/attendance",
      "sourceRoot": "apps/attendance/src",
      "entryFile": "apps/attendance/src/main",
      "compilerOptions": { "tsConfigPath": "apps/attendance/tsconfig.app.json" }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "sourceRoot": "libs/shared/src",
      "entryFile": "index",
      "compilerOptions": { "tsConfigPath": "libs/shared/tsconfig.lib.json" }
    }
  }
}
